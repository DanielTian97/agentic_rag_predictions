/data/probed_trajectories/**/*.csv
/data/evaluation_results/**/*.csv

# Local prediction outputs. README placeholders remain tracked.
/predictions/prediction_head/prediction_results/**/*.csv
/predictions/supervised/prediction_results/**/*.csv

